# Payload/Next pull in packages with broad React 19 peer ranges; do not block
# installs on peer mismatches during scaffolding. Peers are still resolved.
strict-peer-dependencies=false
auto-install-peers=true
# Payload requires several packages to be hoisted to be resolvable at runtime.
public-hoist-pattern[]=*payload*
public-hoist-pattern[]=*drizzle*
