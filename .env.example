# ─────────────────────────────────────────────────────────────────────────────
# Kent Limousines — environment contract
#
# Copy to `.env` and fill in. `.env` is git-ignored and must never be committed.
# The schema in src/lib/env.ts validates these at startup; add new variables to
# BOTH this file and that schema as each integration lands.
#
# Legend: [required now] must be set for local dev · [later] added in a future
# sprint, listed here so the full contract is visible from day one.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ──────────────────────────────────────────────────────────────────────
NODE_ENV=development

# Public site origin (no trailing slash). Per-environment.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Database (Postgres + PostGIS) ─────────────────────────────────────────────
# [required now] Local Docker default matches docker-compose.yml.
# Production uses a Neon connection string (per-PR branch in preview).
DATABASE_URL=postgres://kentlimos:kentlimos@localhost:5432/kentlimos

# ── Payload CMS ───────────────────────────────────────────────────────────────
# [required now] Signing secret — min 32 chars. Generate: `openssl rand -base64 48`
PAYLOAD_SECRET=change-me-to-a-long-random-string-min-32-chars

# ── Integrations (added in their sprints) ─────────────────────────────────────
# Redis (cache, rate limiting) — Upstash
# [later] UPSTASH_REDIS_REST_URL=
# [later] UPSTASH_REDIS_REST_TOKEN=

# Search — Typesense
# [later] TYPESENSE_HOST=
# [later] TYPESENSE_API_KEY=

# Durable workflows — Inngest
# [later] INNGEST_EVENT_KEY=
# [later] INNGEST_SIGNING_KEY=

# Payments — Stripe
# [later] STRIPE_SECRET_KEY=
# [later] STRIPE_WEBHOOK_SECRET=
# [later] NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Messaging — Resend / Twilio / WhatsApp Cloud API
# [later] RESEND_API_KEY=
# [later] TWILIO_ACCOUNT_SID=
# [later] TWILIO_AUTH_TOKEN=
# [later] WHATSAPP_PHONE_NUMBER_ID=
# [later] WHATSAPP_ACCESS_TOKEN=

# Object storage / CDN — Cloudflare R2
# [later] R2_ACCOUNT_ID=
# [later] R2_ACCESS_KEY_ID=
# [later] R2_SECRET_ACCESS_KEY=
# [later] R2_BUCKET=

# Maps & geocoding — Google Maps Platform
# [later] GOOGLE_MAPS_API_KEY=

# Spam prevention — Cloudflare Turnstile
# [later] NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# [later] TURNSTILE_SECRET_KEY=

# Errors — Sentry
# [later] SENTRY_DSN=
# [later] NEXT_PUBLIC_SENTRY_DSN=

# Analytics — GA4 / GTM
# [later] NEXT_PUBLIC_GTM_ID=
